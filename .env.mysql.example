# 复制为项目根目录的 .env.mysql，填写用户名和密码后重启后端。
# 后端自动读取此文件；已设置的系统环境变量优先。实际凭据文件不会提交到 Git。
WEBAPP_MYSQL_HOST=127.0.0.1
WEBAPP_MYSQL_PORT=3306
WEBAPP_MYSQL_USER=
WEBAPP_MYSQL_PASSWORD=
WEBAPP_MYSQL_DATABASE=jijia_sync_isolated_20260827
WEBAPP_MYSQL_TABLE=sale_return_order
# 单次导入超过此行数时要求缩小筛选范围，不会截断后继续分析。
WEBAPP_MYSQL_MAX_ROWS=100000
